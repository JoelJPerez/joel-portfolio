---
import { useTranslations, localizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localizedPath(lang);

const links = [
  { href: `${base}#projects`, label: t('nav.projects') },
  { href: `${base}#skills`, label: t('nav.skills') },
  { href: `${base}#about`, label: t('nav.about') },
  { href: `${base}#contact`, label: t('nav.contact') },
];

const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const otherPath = localizedPath(otherLang);
---

<header
  class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md dark:border-line-dark dark:bg-paper-dark/85"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3.5">
    <a href={`${base}#top`} class="font-mono text-sm font-medium tracking-tight">
      <span class="text-accent dark:text-accent-dark">~/</span>joel-perez
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="hidden rounded-md px-3 py-1.5 text-sm text-muted transition-colors hover:text-ink sm:block dark:text-muted-dark dark:hover:text-ink-dark"
          >
            {l.label}
          </a>
        ))
      }

      <!-- Language switcher -->
      <div
        class="ml-1 flex items-center overflow-hidden rounded-md border border-line font-mono text-xs dark:border-line-dark"
        aria-label="Language"
      >
        <a
          href="/"
          aria-current={lang === 'en' ? 'page' : undefined}
          class:list={[
            'px-2.5 py-1.5 transition-colors',
            lang === 'en'
              ? 'bg-accent font-medium text-white dark:bg-accent-dark dark:text-paper-dark'
              : 'text-muted hover:text-ink dark:text-muted-dark dark:hover:text-ink-dark',
          ]}
        >
          EN
        </a>
        <a
          href="/es/"
          aria-current={lang === 'es' ? 'page' : undefined}
          class:list={[
            'px-2.5 py-1.5 transition-colors',
            lang === 'es'
              ? 'bg-accent font-medium text-white dark:bg-accent-dark dark:text-paper-dark'
              : 'text-muted hover:text-ink dark:text-muted-dark dark:hover:text-ink-dark',
          ]}
        >
          ES
        </a>
      </div>

      <button
        id="theme-toggle"
        type="button"
        aria-label={t('nav.themeToggle')}
        class="ml-1 grid h-9 w-9 place-items-center rounded-md border border-line text-muted transition-colors hover:text-ink dark:border-line-dark dark:text-muted-dark dark:hover:text-ink-dark"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
