---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="border-y border-line bg-card/60 dark:border-line-dark dark:bg-card-dark/40">
  <div class="mx-auto max-w-5xl scroll-mt-20 px-5 py-20">
    <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent dark:text-accent-dark">
      {t('about.eyebrow')}
    </p>
    <h2 class="font-display mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
      {t('about.title')}
    </h2>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_300px]">
      <div class="space-y-4 text-base leading-relaxed text-muted dark:text-muted-dark">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>
      </div>

      <aside class="space-y-5">
        <div class="rounded-xl border border-line bg-card p-5 dark:border-line-dark dark:bg-card-dark">
          <h3 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-muted dark:text-muted-dark">
            {t('about.currently')}
          </h3>
          <p class="mt-2 text-sm leading-relaxed">{t('about.currentlyText')}</p>
        </div>
        <div class="rounded-xl border border-line bg-card p-5 dark:border-line-dark dark:bg-card-dark">
          <h3 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-muted dark:text-muted-dark">
            {t('about.education')}
          </h3>
          <p class="mt-2 text-sm leading-relaxed">{t('about.educationText')}</p>
        </div>
      </aside>
    </div>
  </div>
</section>
