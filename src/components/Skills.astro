---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const groups = [
  {
    name: t('skills.backend'),
    items: ['C#', '.NET 8 / ASP.NET', 'CQRS · MediatR', 'Node.js / NestJS', 'Java / Spring Boot', 'Python', 'REST APIs'],
  },
  {
    name: t('skills.frontend'),
    items: ['Angular', 'React', 'Redux Toolkit', 'TypeScript', 'JavaScript (ES6+)', 'Tailwind CSS', 'HTML5 / CSS3'],
  },
  {
    name: t('skills.databases'),
    items: ['SQL Server', 'PostgreSQL', 'MySQL', 'MongoDB', 'EF Core'],
  },
  {
    name: t('skills.automation'),
    items: ['Selenium WebDriver', 'Playwright', 'AutoHotkey'],
  },
  {
    name: t('skills.cloud'),
    items: ['Docker', 'AWS', 'Azure', 'Git / GitHub', 'GitHub Actions CI/CD'],
  },
  {
    name: t('skills.practices'),
    items: ['Clean Architecture', 'Multi-tenancy', 'Scrum / Agile', 'Conventional Commits'],
  },
];
---

<section id="skills" class="mx-auto max-w-5xl scroll-mt-20 px-5 py-20">
  <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent dark:text-accent-dark">
    {t('skills.eyebrow')}
  </p>
  <h2 class="font-display mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
    {t('skills.title')}
  </h2>

  <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      groups.map((group) => (
        <div>
          <h3 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-muted dark:text-muted-dark">
            {group.name}
          </h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="rounded-md border border-line bg-card px-2 py-1 font-mono text-xs dark:border-line-dark dark:bg-card-dark">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
